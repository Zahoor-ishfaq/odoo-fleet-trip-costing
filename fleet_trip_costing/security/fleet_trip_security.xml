<odoo>
    <record id="module_category_fleet_trip_costing" model="ir.module.category">
        <field name="name">Fleet Trip Costing</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_fleet_trip_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_fleet_trip_costing"/>
        <!-- Without base.group_user, a user with only this group cannot
             read ir.sequence, which fleet.trip.create() depends on for
             its TRIP/YYYY/NNNNN numbering. -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_fleet_trip_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_fleet_trip_costing"/>
        <field name="implied_ids" eval="[(4, ref('group_fleet_trip_user'))]"/>
    </record>

    <record id="fleet_trip_company_rule" model="ir.rule">
        <field name="name">Fleet Trip: multi-company</field>
        <field name="model_id" ref="model_fleet_trip"/>
        <field name="groups" eval="[(4, ref('group_fleet_trip_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
