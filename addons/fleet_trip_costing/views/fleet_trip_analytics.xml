<odoo>
    <record id="fleet_trip_view_pivot" model="ir.ui.view">
        <field name="name">fleet.trip.view.pivot</field>
        <field name="model">fleet.trip</field>
        <field name="arch" type="xml">
            <pivot string="Trip Profitability">
                <field name="vehicle_id" type="row"/>
                <field name="driver_id" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="total_cost" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="distance_km" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="fleet_trip_view_graph" model="ir.ui.view">
        <field name="name">fleet.trip.view.graph</field>
        <field name="model">fleet.trip</field>
        <field name="arch" type="xml">
            <graph string="Margin by Vehicle" type="bar">
                <field name="vehicle_id" type="row"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="fleet_trip_action_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">10</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="fleet_trip_view_pivot"/>
        <field name="act_window_id" ref="fleet_trip_action"/>
    </record>

    <record id="fleet_trip_action_view_graph" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="fleet_trip_view_graph"/>
        <field name="act_window_id" ref="fleet_trip_action"/>
    </record>
</odoo>
